# Required
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DB_PATH=/data/polysharp.db

# Morning shortlist (optional - defaults shown)
SUGGEST_TIME=08:00
BOT_TZ=America/Halifax
SUGGEST_COUNT=8
SUGGEST_MIN_BETS=100
SUGGEST_MIN_STAKED=500000
SUGGEST_MIN_ROI=0.02
SUGGEST_MIN_SPORTS_SHARE=0.8
SUGGEST_MAX_LIVE_SHARE=0.25
SUGGEST_MAX_DAYS_INACTIVE=7
SUGGEST_COOLDOWN_DAYS=3

# Alerts (optional)
SPORTS_ONLY_ALERTS=true
PREGAME_ONLY_ALERTS=true
MIN_ALERT_USD=2000
ALERT_SELLS=true
CONSENSUS_ALERT_WALLETS=3
LIVE_HEDGE_ALERTS=true
CONVICTION_MIN_TAKER=0.8
CONVICTION_MAX_BASELINE=0.4

# If Railway ever blocks Polymarket:
# HTTPS_PROXY=http://user:pass@host:port
