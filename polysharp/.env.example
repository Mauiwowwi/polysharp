# Required
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Storage - attach a Railway volume at /data
DB_PATH=/data/polysharp.db

# Wallet selection
LB_SLICES=MONTH:OVERALL,ALL:OVERALL,MONTH:SPORTS,ALL:SPORTS
LB_DEPTH=100
MAX_WALLETS=40
REFRESH_HOURS=24
MIN_CLOSED=40
MIN_WIN_RATE=0.55
MIN_ROI=0.04
MIN_REALIZED_PNL=25000
MAX_DAYS_INACTIVE=14

# Alerts
MIN_ALERT_USD=2000
ALERT_SELLS=true
BUNDLE_SECONDS=20
MIN_PRICE=0.03
MAX_PRICE=0.97
CONSENSUS_WALLETS=2
CONSENSUS_HOURS=6
# Conviction: bundle >= 80% taker from a wallet normally <= 40% taker
CONVICTION_MIN_TAKER=0.8
CONVICTION_MAX_BASELINE=0.4

# Transport
USE_WEBSOCKET=true
POLL_SECONDS=15
# If Railway egress blocks Polymarket, route through a proxy:
# HTTPS_PROXY=http://user:pass@host:port
