# Required
TELEGRAM_BOT_TOKEN=
# one id, or several comma-separated (e.g. group + your private chat)
TELEGRAM_CHAT_ID=
# your Telegram user id(s); only these can /add, /remove, /mute, etc.
ADMIN_USER_IDS=
DB_PATH=/data/polysharp.db

# Morning shortlist (optional - defaults shown)
SUGGEST_TIME=08:00
BOT_TZ=America/Halifax
SUGGEST_COUNT=8
SUGGEST_MIN_MONTH_VOL=250000
SUGGEST_MIN_MONTH_PNL=0
SUGGEST_MIN_PNL=25000
SUGGEST_MIN_MARGIN=0.002
SUGGEST_MIN_PREDICTIONS=200
SUGGEST_MIN_AVG_BET=1000
SUGGEST_MIN_WIN_RATE=0
SUGGEST_MIN_SPORTS_SHARE=0.8
SUGGEST_MAX_LIVE_SHARE=0.25
SUGGEST_MAX_DAYS_INACTIVE=7
SUGGEST_COOLDOWN_DAYS=3

# Alerts (optional)
SPORTS_ONLY_ALERTS=true
PREGAME_ONLY_ALERTS=true
MIN_ALERT_USD=2000
ALERT_SELLS=true
CONSENSUS_ALERT_WALLETS=3
TIER_HIGH=4
TIER_MED=2
LIVE_HEDGE_ALERTS=false
CONVICTION_MIN_TAKER=0.8
CONVICTION_MAX_BASELINE=0.4

# If Railway ever blocks Polymarket:
# HTTPS_PROXY=http://user:pass@host:port
